# App environment (development or production)
EXPO_PUBLIC_APP_ENV=development

# Your Supabase project URL: Note the ip address is displayed when you run npx expo start (Metro server)
EXPO_PUBLIC_SUPABASE_URL=http://<IP ADDRESS FROM METRO>:54321

# Your Supabase anon/public key (get this by running supabase start or supabase status)
EXPO_PUBLIC_SUPABASE_PUB_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>


# Google Sign-In OAuth Client IDs (get these from Google Cloud Console)

# Web Client ID - used for both Android token exchange and Supabase
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<YOUR_WEB_CLIENT_ID_FROM_GOOGLE_CONSOLE>.apps.googleusercontent.com
# iOS Client ID - required for iOS native sign-in
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<YOUR_IOS_CLIENT_ID_FROM_GOOGLE_CONSOLE>.apps.googleusercontent.com


# Python API base URL — only needed once a feature calls the API (the fresh app
# doesn't: account deletion is a database function by default; flip
# ACCOUNT_DELETION in src/lib/api.ts to 'api' to route it through the API
# instead). When you do use it: run
# python on 0.0.0.0:8080 (not 127.0.0.1) and use the same IP address as the
# Metro server's (from npx expo start).
EXPO_PUBLIC_API_URL=http://<IP ADDRESS FROM METRO>:8080
